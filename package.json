{
  "name": "drift",
  "displayName": "Drift - Documentation Sync Detector",
  "description": "Detect when documentation drifts out of sync with your code: JSDoc, docstrings, README code blocks, Git history, and optional AI semantic checks",
  "version": "0.7.2",
  "publisher": "pallaprolus",
  "pricing": "Free",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0b1f3a",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://vsmarketplacebadges.dev/version-short/pallaprolus.drift.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=pallaprolus.drift",
      "description": "VS Code Marketplace version"
    },
    {
      "url": "https://vsmarketplacebadges.dev/installs-short/pallaprolus.drift.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=pallaprolus.drift",
      "description": "Marketplace installs"
    },
    {
      "url": "https://vsmarketplacebadges.dev/rating-short/pallaprolus.drift.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=pallaprolus.drift&ssr=false#review-details",
      "description": "Marketplace rating"
    },
    {
      "url": "https://img.shields.io/open-vsx/v/pallaprolus/drift?label=open%20vsx",
      "href": "https://open-vsx.org/extension/pallaprolus/drift",
      "description": "Open VSX version"
    },
    {
      "url": "https://img.shields.io/github/actions/workflow/status/pallaprolus/drift/test.yml?branch=main&label=tests",
      "href": "https://github.com/pallaprolus/drift/actions/workflows/test.yml",
      "description": "Test status"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pallaprolus/drift"
  },
  "homepage": "https://github.com/pallaprolus/drift#readme",
  "bugs": {
    "url": "https://github.com/pallaprolus/drift/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "AI"
  ],
  "keywords": [
    "documentation",
    "docs",
    "documentation drift",
    "stale docs",
    "docstring",
    "jsdoc",
    "javadoc",
    "godoc",
    "rustdoc",
    "comments",
    "readme",
    "markdown",
    "code review",
    "technical debt",
    "maintenance",
    "git",
    "typescript",
    "javascript",
    "python",
    "go",
    "rust",
    "java",
    "ai",
    "sync",
    "drift"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "drift.scanWorkspace",
        "title": "Drift: Scan Workspace for Documentation Drift",
        "icon": "$(search)"
      },
      {
        "command": "drift.scanCurrentFile",
        "title": "Drift: Scan Current File"
      },
      {
        "command": "drift.markAsReviewed",
        "title": "Drift: Mark as Reviewed"
      },
      {
        "command": "drift.showDashboard",
        "title": "Drift: Show Staleness Dashboard"
      },
      {
        "command": "drift.refreshDashboard",
        "title": "Drift: Refresh Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "drift.exportReport",
        "title": "Drift: Export Report (Markdown, HTML, JSON)",
        "icon": "$(export)"
      },
      {
        "command": "drift.analyzeSemantic",
        "title": "Drift: AI Check Documentation at Cursor"
      },
      {
        "command": "drift.analyzeSemanticFile",
        "title": "Drift: AI Check All Documentation in Current File"
      },
      {
        "command": "drift.setAnthropicApiKey",
        "title": "Drift: Set Anthropic API Key"
      },
      {
        "command": "drift.clearAnthropicApiKey",
        "title": "Drift: Clear Anthropic API Key"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "driftDashboard",
          "name": "Drift Dashboard",
          "icon": "$(book)",
          "contextualTitle": "Documentation Drift"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "drift.refreshDashboard",
          "when": "view == driftDashboard",
          "group": "navigation"
        },
        {
          "command": "drift.scanWorkspace",
          "when": "view == driftDashboard",
          "group": "navigation"
        },
        {
          "command": "drift.exportReport",
          "when": "view == driftDashboard",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "drift.markAsReviewed",
          "when": "view == driftDashboard && viewItem == driftItem"
        }
      ],
      "commandPalette": [
        {
          "command": "drift.analyzeSemantic",
          "when": "editorIsOpen"
        },
        {
          "command": "drift.analyzeSemanticFile",
          "when": "editorIsOpen"
        }
      ],
      "editor/context": [
        {
          "command": "drift.analyzeSemantic",
          "when": "editorTextFocus && resourceLangId =~ /^(typescript|javascript|typescriptreact|javascriptreact|python|go|rust|java)$/",
          "group": "drift@1"
        }
      ]
    },
    "configuration": {
      "title": "Drift",
      "properties": {
        "drift.enableGutterIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show gutter icons for potentially stale documentation"
        },
        "drift.enableInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline decorations for drift warnings"
        },
        "drift.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to exclude from scanning"
        },
        "drift.supportedLanguages": {
          "type": "array",
          "default": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
            "python",
            "go",
            "java",
            "rust"
          ],
          "description": "Languages to scan for documentation drift"
        },
        "drift.driftThreshold": {
          "type": "number",
          "default": 0.3,
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence threshold (0-1) for flagging documentation as potentially stale"
        },
        "drift.showInProblems": {
          "type": "boolean",
          "default": true,
          "description": "Publish drift findings to the Problems panel as diagnostics (source: drift)"
        },
        "drift.scanMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Check code blocks in README and other Markdown files against the real code (renamed functions, changed signatures, wrong argument counts)"
        },
        "drift.markdownPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/README.md",
            "**/docs/**/*.md"
          ],
          "description": "Glob patterns (relative to the workspace) of Markdown files whose code blocks are checked"
        },
        "drift.git.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use Git history to flag code that changed more recently than its documentation, and uncommitted code edits whose docs were not touched"
        },
        "drift.git.staleDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Flag documentation when the code was committed this many days (or more) after the documentation was last changed"
        },
        "drift.ai.provider": {
          "type": "string",
          "enum": [
            "auto",
            "anthropic",
            "vscode",
            "off"
          ],
          "enumDescriptions": [
            "Use Anthropic when an API key is set, otherwise the VS Code language model API (e.g. GitHub Copilot)",
            "Always use the Anthropic API (requires \"Drift: Set Anthropic API Key\")",
            "Always use the VS Code language model API (requires a chat provider such as GitHub Copilot)",
            "Disable AI checks and hide the AI CodeLens"
          ],
          "default": "auto",
          "description": "Provider for on-demand AI semantic drift checks. Drift never sends code to an AI provider automatically; you trigger each check"
        },
        "drift.ai.model": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Anthropic model ID used for AI semantic checks (only applies to the Anthropic provider)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:unit": "tsc -p . --outDir out && node runUnitTests.js",
    "build:cli": "node esbuild.js --cli",
    "prepare": "node esbuild.js --cli",
    "publish:npm": "node scripts/publish-npm.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "chai": "^6.2.1",
    "esbuild": "^0.27.0",
    "eslint": "^8.54.0",
    "glob": "^13.0.0",
    "minimatch": "^9.0.3",
    "mocha": "^11.7.5",
    "typescript": "^5.3.0"
  },
  "bin": {
    "drift-check": "dist/cli.js"
  }
}
